diff --git a/tools/bench/picom-blur-glx.conf b/tools/bench/picom-blur-glx.conf
deleted file mode 100644
index d87141f..0000000
--- a/tools/bench/picom-blur-glx.conf
+++ /dev/null
@@ -1,16 +0,0 @@
-# picom settings matching tools/bench/compust-blur.toml with the glx backend.
-# No shadows, fades, rounded corners, dimming, or unredirection, which Compust lacks.
-vsync = true;
-use-damage = true;
-shadow = false;
-fading = false;
-corner-radius = 0;
-inactive-opacity = 1.0;
-active-opacity = 1.0;
-frame-opacity = 1.0;
-unredir-if-possible = false;
-blur-background = true;
-# Dual Kawase, the usual glx choice; strength 0 approximates a size-9 box (radius 4).
-blur-method = "dual_kawase";
-blur-size = 9;
-blur-strength = 0;
