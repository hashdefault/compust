diff --git a/tools/desktop/i3.config b/tools/desktop/i3.config
new file mode 100644
index 0000000..44bb543
--- /dev/null
+++ b/tools/desktop/i3.config
@@ -0,0 +1,12 @@
+# Private i3 configuration for tools/desktop-check.sh: tiled, reparented clients with title
+# bars, no bar, and no key bindings.
+font pango:monospace 8
+default_border normal
+workspace_layout default
+focus_follows_mouse no
+
+# i3 only keeps workspaces that are focused or hold a window. The probe's small anchor
+# window goes to a second workspace, floating, so that workspace exists and stays empty
+# where the probe checks pixels.
+for_window [title="^Compust workspace anchor$"] floating enable
+assign [title="^Compust workspace anchor$"] 2
